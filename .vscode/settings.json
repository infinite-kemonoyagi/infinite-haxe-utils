{
  "[haxe]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
  },

  "prettier.tabWidth": 2,
  "editor.tabSize": 2,

  "files.insertFinalNewline": true,
  "prettier.endOfLine": "lf",
  "files.eol": "\n",

  "haxe.configurations": [
		{
			"label": "Default",
			"args": [
				"-lib",
				"openfl",
				"-lib",
				"flixel",
			]
		}
	],
}
